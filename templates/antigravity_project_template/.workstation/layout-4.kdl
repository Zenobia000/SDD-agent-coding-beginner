// 4-pane workstation: ENV / RUN / WATCH / CHECK
//
// Layout:
//   ┌──────────────┬──────────────┐
//   │   ENV        │   RUN        │
//   ├──────────────┼──────────────┤
//   │   WATCH      │   CHECK      │
//   └──────────────┴──────────────┘
//
// 適用：Docker Compose 多服務、AI Agent、RAG 系統

layout {
    tab name="workstation" focus=true {
        pane split_direction="horizontal" {
            pane split_direction="vertical" {
                pane name="ENV" {
                    command "bash"
                    args "-c" "echo '── ENV: 環境啟動 (docker compose ps / up / conda activate)'; exec bash"
                }
                pane name="RUN" {
                    command "bash"
                    args "-c" "echo '── RUN: 主任務 (make run / train / pipeline)'; exec bash"
                }
            }
            pane split_direction="vertical" {
                pane name="WATCH" {
                    command "bash"
                    args "-c" "echo '── WATCH: 日誌觀測 (docker compose logs -f / tail -f)'; exec bash"
                }
                pane name="CHECK" {
                    command "bash"
                    args "-c" "echo '── CHECK: 驗證 (curl /health / pytest / nvidia-smi)'; exec bash"
                }
            }
        }
    }
}
