// 3-pane workstation: RUN / WATCH / CHECK
//
// Layout:
//   ┌──────────────┬──────────────┐
//   │   RUN        │   WATCH      │
//   ├──────────────┴──────────────┤
//   │          CHECK              │
//   └─────────────────────────────┘
//
// 自訂：把每個 pane 的 args 改成你要自動執行的指令
// 例如：args "-c" "make run; exec bash"

layout {
    tab name="workstation" focus=true {
        pane split_direction="horizontal" {
            pane split_direction="vertical" {
                pane name="RUN" {
                    command "bash"
                    args "-c" "echo '── RUN: 跑主任務 (make run / npm run dev / uvicorn app.main:app --reload)'; exec bash"
                }
                pane name="WATCH" {
                    command "bash"
                    args "-c" "echo '── WATCH: 系統日誌 (docker compose logs -f / tail -f logs/app.log)'; exec bash"
                }
            }
            pane name="CHECK" {
                command "bash"
                args "-c" "echo '── CHECK: 驗證資源 (curl /health / pytest / nvidia-smi)'; exec bash"
            }
        }
    }
}
