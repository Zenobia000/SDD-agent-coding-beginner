#!/usr/bin/env bash
# Workstation launcher — Mac / Linux / WSL
# Usage:
#   ./start          # 3-pane (RUN / WATCH / CHECK)
#   ./start 4        # 4-pane (ENV / RUN / WATCH / CHECK)
#   ./start <name>   # use .workstation/<name>.kdl

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_ROOT"

LAYOUT_NAME="${1:-default}"
case "$LAYOUT_NAME" in
    default|3) LAYOUT_FILE="$PROJECT_ROOT/.workstation/layout.kdl" ;;
    4)         LAYOUT_FILE="$PROJECT_ROOT/.workstation/layout-4.kdl" ;;
    *)         LAYOUT_FILE="$PROJECT_ROOT/.workstation/${LAYOUT_NAME}.kdl" ;;
esac

if [[ ! -f "$LAYOUT_FILE" ]]; then
    echo "Error: layout not found: $LAYOUT_FILE" >&2
    exit 1
fi

if ! command -v zellij >/dev/null 2>&1; then
    cat >&2 <<'EOF'
zellij not installed. Install:
  Mac:        brew install zellij
  Linux/WSL:  cargo install --locked zellij
              (or download binary: https://github.com/zellij-org/zellij/releases)
EOF
    exit 1
fi

if [[ -n "${ZELLIJ:-}" ]]; then
    echo "Already inside a zellij session. Detach (Ctrl-q) or use a new terminal." >&2
    exit 1
fi

SESSION_NAME="ws-$(basename "$PROJECT_ROOT")"
exec zellij --layout "$LAYOUT_FILE" --session "$SESSION_NAME"
