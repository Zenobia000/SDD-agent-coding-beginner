#!/usr/bin/env bash
# 機械層 secret 閘門：誤提交真實 .env 或明顯 API key 時中止 commit。
# 文件規則只能提醒；Git hook 同時約束人與任何 agent。
set -euo pipefail

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM || true)

# 1. 擋下誤加的真 .env，只允許明確的範例檔。
for f in $staged; do
  case "$f" in
    .env|.env.*)
      case "$f" in
        *.example|*.sample|*.template) ;;
        *) echo "🔴 擋下：不要 commit $f（secret 會外洩）。只提交明確的 example/sample/template。"; fail=1 ;;
      esac
      ;;
  esac
done

# 2. 掃 staged 內容有沒有寫死的 Google API key（AIza 開頭 + 35 字）
if git diff --cached -U0 | grep -nE '^\+.*AIza[0-9A-Za-z_-]{35}' >/dev/null 2>&1; then
  echo "🔴 擋下：偵測到疑似寫死的 Google API key。改用環境變數讀取。"
  git diff --cached -U0 | grep -nE '^\+.*AIza[0-9A-Za-z_-]{35}' | head -3
  fail=1
fi

# Placeholder 是功能問題，不是秘密外洩；這裡只擋不可逆的 credential commit。

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "提交已中止。修好上面問題後再 commit。"
  echo "不要用 --no-verify 繞過檢查；請移除敏感內容，改用環境變數與假值範例檔。"
  exit 1
fi
